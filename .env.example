# Community mode works without external credentials.
ATLAS_STUDIO_MODE=community
ATLAS_STUDIO_HOST=0.0.0.0
ATLAS_STUDIO_PORT=8080
ATLAS_STUDIO_DATABASE_URL=postgresql://atlas_studio:atlas-studio@postgres:5432/atlas_studio
ATLAS_STUDIO_REDIS_URL=redis://redis:6379/0
ATLAS_STUDIO_ARTIFACT_BACKEND=filesystem
ATLAS_STUDIO_ARTIFACT_ROOT=./data/artifacts
ATLAS_STUDIO_WORKSPACE_ROOT=.
ATLAS_STUDIO_WORKSPACE_MAX_PREVIEW_KB=512
ATLAS_STUDIO_DEFAULT_PROVIDER=ollama
ATLAS_STUDIO_DEFAULT_MODEL=qwen3:4b
# Dedicated local tool-calling model used by Forge implementation plans.
ATLAS_STUDIO_FORGE_MODEL=qwen3:4b
ATLAS_STUDIO_OLLAMA_URL=http://ollama:11434

# LiteLLM Configuration
ATLAS_STUDIO_LITELLM_API_BASE=http://ollama:11434
ATLAS_STUDIO_LITELLM_API_KEY=
ATLAS_STUDIO_LITELLM_MODEL_PREFIX=ollama
ATLAS_STUDIO_LITELLM_FALLBACK_MODELS=[]
ATLAS_STUDIO_LITELLM_COST_TRACKING=true
ATLAS_STUDIO_LITELLM_NUM_RETRIES=2
ATLAS_STUDIO_LITELLM_TIMEOUT=120
ATLAS_STUDIO_MODEL_TIMEOUT_SECONDS=120
ATLAS_STUDIO_MODEL_MAX_TOKENS=384
# Extra token budget reserved exclusively for reasoning on thinking models (qwen3).
ATLAS_STUDIO_MODEL_THINKING_TOKENS=4096
# Connection retry attempts with backoff when the local model server is unreachable.
ATLAS_STUDIO_MODEL_CONNECT_RETRIES=3
# Forge uses a larger, separate budget for structured multi-file proposals.
ATLAS_STUDIO_FORGE_TIMEOUT_SECONDS=300
ATLAS_STUDIO_FORGE_MAX_TOKENS=2048
ATLAS_STUDIO_FORGE_CONTEXT_TOKENS=4096
ATLAS_STUDIO_SANDBOX_RUNTIME=docker
ATLAS_STUDIO_SANDBOX_NETWORK=none
ATLAS_STUDIO_SANDBOX_MEMORY=512m
ATLAS_STUDIO_SANDBOX_CPUS=1.0
ATLAS_STUDIO_SANDBOX_PIDS=128
ATLAS_STUDIO_WORKER_URL=http://worker:8092
# Shared only inside the local Compose network; replace before network exposure.
ATLAS_STUDIO_WORKER_TOKEN=atlas-local-worker
ATLAS_STUDIO_WORKER_MEMORY=1g
ATLAS_STUDIO_WORKER_CPUS=2.0
ATLAS_STUDIO_WORKER_PIDS=256
ATLAS_STUDIO_RESEARCH_WORKER_URL=http://research-worker:8093
ATLAS_STUDIO_RESEARCH_WORKER_TOKEN=atlas-local-research
ATLAS_STUDIO_UPLOAD_MAX_MB=25
ATLAS_STUDIO_TELEMETRY_ENABLED=false

# Optional integrations (only read when ATLAS_STUDIO_MODE=integrations and enabled).
ATLAS_STUDIO_MINIO_ENABLED=false
ATLAS_STUDIO_MINIO_ENDPOINT=minio:9000
ATLAS_STUDIO_MINIO_ACCESS_KEY=
ATLAS_STUDIO_MINIO_SECRET_KEY=
ATLAS_STUDIO_STT_URL=
ATLAS_STUDIO_TTS_URL=
# Atlas voice persona: ChatterboxTTS clones the bundled female reference voice
# (models/voice/atlas-female-ref.wav, CC0 LJSpeech samples). Point this at your own
# ~20s WAV to clone a different speaker, or set to "none" for the engine default.
# ATLAS_STUDIO_TTS_AUDIO_PROMPT=
# Delivery tuning: lower = calmer/smoother, higher = more expressive/faster.
# ATLAS_STUDIO_TTS_EXAGGERATION=0.4
# ATLAS_STUDIO_TTS_CFG_WEIGHT=0.35

# Optional multi-user authentication foundation. Disabled in Community mode.
ATLAS_STUDIO_GOOGLE_OAUTH_ENABLED=false
ATLAS_STUDIO_GOOGLE_OAUTH_CLIENT_ID=
ATLAS_STUDIO_GOOGLE_OAUTH_CLIENT_SECRET=

# Atlas voice persona: local American female voices.
ATLAS_SPEECH_KOKORO_VOICE=af_bella
ATLAS_SPEECH_KOKORO_SPEED=0.94
ATLAS_SPEECH_PIPER_VOICE=en_US-kristin-medium
ATLAS_SPEECH_TTS_PRIMARY=kokoro

# Optional local, open-source image-to-3D worker. No API key or paid service.
ATLAS_STUDIO_AVATAR_LOCAL_ENABLED=false
ATLAS_STUDIO_AVATAR_PROVIDER=triposr-local
ATLAS_STUDIO_AVATAR_SERVICE_URL=http://avatar3d:8090

# Optional LiteAvatar + OpenAvatarChat local runtime. This is source-only;
# the official model files are downloaded into a named Docker volume on first run.
ATLAS_STUDIO_OPEN_AVATAR_CHAT_REF=main
